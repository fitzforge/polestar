# Copy to .env next to compose.yaml and fill in. Never commit .env.

# The bot's token: Discord Developer Portal, your application, Bot, Reset Token.
DISCORD_TOKEN=

# The #bugs forum channel's id (Developer Mode on, right-click #bugs, Copy Channel ID).
DISCORD_FORUM_ID=

# Fine-grained GitHub token (or a GitHub App's), repository fitzforge/polestar
# only, with Issues: Read and write and nothing else. No Contents: with it a
# stolen token could push branches or replace release assets.
GITHUB_TOKEN=

# Where issues go.
GITHUB_REPO=fitzforge/polestar

# The GitHub account GITHUB_TOKEN acts as (a GitHub App's is name[bot]).
# When set, only issues that account opened are read back as filed from a
# Discord thread. Set the same as a repository variable for the Actions.
# BOT_GITHUB_LOGIN=

# Where screenshots go: a separate public repository (e.g. an empty
# fitzforge/polestar-bug-media) and a second fine-grained token with
# Contents: Read and write on that repository alone. The bot makes the branch
# there (orphan, never merged).
MEDIA_REPO=fitzforge/polestar-bug-media
MEDIA_TOKEN=
MEDIA_BRANCH=bug-media
# Left unset, MEDIA_REPO and MEDIA_TOKEN fall back to GITHUB_REPO and
# GITHUB_TOKEN, which then needs Contents write on the main repository; the
# bot warns about that on every start.

# Posts made before this time are never filed (ISO date). Leave empty to file
# every open post the first time the bot starts.
SYNC_SINCE=
