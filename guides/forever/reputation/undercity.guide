  collect 2834 x8 quest 358.3         -- Embalming Ichor
  collect 2858 x5 quest 367.1         -- Darkhound Blood
  collect 2855 x7 quest 404.1         -- Putrid Claw
  collect 279991 x6 quest 86784.1     -- Dry Branch

