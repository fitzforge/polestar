  accept 3112 only Gnome,Warrior              -- Sten Stoutarm: Simple Memorandum
  turnin 3106 only Dwarf,Warrior              -- Thran Khorman, the warrior trainer
  turnin 3112 only Gnome,Warrior              -- Thran Khorman, the warrior trainer
  accept 3107 only Paladin                    -- Sten Stoutarm: Consecrated Rune
  turnin 3107 only Paladin                    -- Bromos Grummner, the paladin trainer
  accept 3108 only Hunter                     -- Sten Stoutarm: a rune for Thorgas Grimson
  turnin 3108 only Hunter                     -- Thorgas Grimson, the hunter trainer
  accept 3109 only Dwarf,Rogue                -- Sten Stoutarm: Encrypted Rune
  accept 3113 only Gnome,Rogue                -- Sten Stoutarm: Encrypted Memorandum
  turnin 3109 only Dwarf,Rogue                -- Solm Hargrin, the rogue trainer
  turnin 3113 only Gnome,Rogue                -- Solm Hargrin, the rogue trainer
  accept 3110 only Dwarf,Priest               -- Sten Stoutarm: Hallowed Rune
  accept 98574 only Gnome,Priest              -- Sten Stoutarm: Hallowed Memorandum
  turnin 3110 only Dwarf,Priest               -- Branstock Khalder, the priest trainer
  turnin 98574 only Gnome,Priest              -- Branstock Khalder, the priest trainer
