  turnin 471                              -- James Halloran
  accept 98072
  turnin 286                              -- Karl Boran
  accept 98189 npc 1242                   -- Karl Boran: for Captain Stoutfist in the keep
  turnin 98189 npc 2104                   -- Captain Stoutfist, on the top floor
  accept 98190 npc 2104                   -- For Bolvar Fordragon in Stormwind Keep: keep it
  turnin 289                              -- First Mate Fitzsimmons, in the inn
  accept 290
