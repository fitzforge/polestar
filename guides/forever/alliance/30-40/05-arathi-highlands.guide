# ---------------------------------------------------------------- Loch Modan

step Ironforge
  zone Ironforge
  fly "Ironforge"                     -- Darla Harris, Southshore
  turnin 554                          -- Prospector Stormpike, Hall of Explorers
  train class only Warrior,Paladin,Hunter,Rogue,Priest,Shaman,Mage,Warlock

step Thelsamar
  zone Loch Modan
  tip From Ironforge take the tunnel east through Dun Morogh into Loch Modan and follow the road to Thelsamar.
  getfp "Thelsamar"
  sethome "Stoutlager Inn"
  accept 2500                         -- Ghak Healtouch

step Ironband's Excavation Site
  tip South-east along the loch to the dig site.
  accept 738                          -- Prospector Ironband
