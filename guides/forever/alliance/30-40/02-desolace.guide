# ---------------------------------------------------------------- To Stormwind

step Fly to Auberdine
  zone Desolace
  goto 64.7,10.4 "Nijel's Point flight master"
  fly "Auberdine"
  zone Darkshore

step Boat to Stormwind Harbor
  when !zone "Stormwind City"
  zone Darkshore
  goto 30.7,41.0 "Boat to Stormwind Harbor"