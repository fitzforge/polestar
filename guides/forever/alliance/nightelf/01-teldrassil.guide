# ---------------------------------------------------------------- West: Fel Rock to Gnarlpine Hold

# Fel Rock's mouth: "Cave entrance at 54,52", "The cave entrance is at:
# 54,52; and he is inside the cave at: 51,50"
# (https://www.wowhead.com/classic/quest=932, comments).
step Fel Rock's mouth
  goto 54.0,52.0 "Fel Rock"

step Fel Rock
  tip Lord Melenas waits inside the cave, at the bottom or up on the ledge; keep to the right.
  collect 5221 quest 932.1                    -- Lord Melenas

step The road to Darnassus
  tip Gnarlpine Ambushers hide along the road west of Fel Rock.
  kill 2152 quest 487.1

step Ban'ethil Barrow Den
  tip The barrow is south of the road. Sentinel Lynessa Duskblossom is held inside, Oben Rageclaw sleeps in its depths, and the four relic chests sit in the lower rooms.
  accept 99053                                -- Sentinel Lynessa Duskblossom
  accept 2541                                 -- Oben Rageclaw
  collect 3405 quest 483.1
  collect 3406 quest 483.2
  collect 3407 quest 483.3
  collect 3408 quest 483.4
  collect 8363 quest 2541.1                   -- Gnarlpine Shamans
  turnin 2541
  accept 2561
  kill 7318 quest 2561.1                      -- Rageclaw, in the den
  turnin 2561

step Escaping Ban'ethil
  tip Escort Sentinel Lynessa Duskblossom out of the barrow; Sentinel Kyra Starsong in Dolanaar takes the report.
  goto 46.4,57.3 "Ban'ethil Hollow, outside the barrow" r 25 -- Walk Lynessa out and keep her alive
  complete 99053

step The Pools of Arlithrien
  tip South-west of the barrow. The moonwell sits by the pools.
  collect 5645 quest 933.1 @42.4,67.1         -- Use the Tourmaline Phial at the moonwell

step Gnarlpine Hold
  tip South of the pools. The Strange Fruited Plant grows by the Hold.
  accept 930                                  -- Strange Fruited Plant

