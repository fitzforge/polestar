  kill 2748                   -- Uldaman
  kill 7267                   -- Zul'Farrak
  kill 12201                  -- Maraudon
  kill "the final boss of Alcaz Prison"
  kill 5709                   -- Sunken Temple
  kill 9019                   -- Blackrock Depths
