  goto 45.1,33.8 "Poor Copper" r 60
  goto 38.0,50.8 "Copper" r 60
  goto 41.0,52.4 "Copper" r 60
  goto 42.8,49.6 "Copper" r 60
  goto 44.9,43.0 "Poor Copper" r 60
