  goto 20.3,71.2
  goto 23.5,75.5
  goto 27.5,77.0
  goto 31.0,78.9
  goto 33.4,76.7
  goto 24.8,77.5
  collect 262818 x30 quest 93831.1      -- Bear Berries

step Barkskin Burrow
  tip Back to Osi, then the two elders at the back of the burrow. Suma Mossmane stands beside Osi, Thobon Sapclaw a little north-west of them, where the recording met him. Suma's moss grows around Elderwild, later in this guide; Thobon's amulets come from the harpies at the Shrine of Aviana, also later in this guide, and you bring both back here then.
  turnin 93831                          -- Osi Mistpaw
  accept 91697                          -- Meet the Elders
  talk 256650                           -- Elder Pinespeaker
  talk 256627                           -- Elder Mistpaw
  turnin 91697                          -- Elder Mistpaw
  accept 93826                          -- Deal Dread to Deadwood: on your way back here later; keep it
  accept 93825                          -- Suma Mossmane: Barkbound Blessings
  accept 93827 @20.6,78.8               -- Thobon Sapclaw: Windswept Wards

