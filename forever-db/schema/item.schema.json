{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema/item.schema.json",
  "title": "item",
  "description": "One row per item id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "client item id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "name"
    },
    "quest_item": {
      "type": "boolean",
      "description": "a quest item"
    }
  }
}
