{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "schema/object.schema.json",
  "title": "object",
  "description": "One row per game object id.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id"
  ],
  "properties": {
    "id": {
      "type": "integer",
      "minimum": 1,
      "description": "client game object id"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "description": "name"
    },
    "type": {
      "type": "integer",
      "minimum": 0,
      "description": "client game object type"
    }
  }
}
